  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "fast-xml-parser": "^5.11.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "xnb": "1.3.0-a"
  }
}
