{
  "name": "jump-king",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "import:original": "node scripts/import-original.cjs",
    "import:details": "node scripts/import-original-details.cjs",
    "dev": "pnpm build && pnpm --parallel --filter web --filter game-server dev",
    "start": "pnpm --filter game-server start",
    "build:cloudflare": "VITE_SERVER_URL=${VITE_SERVER_URL:-wss://jumpking-lighthouse2815.duckdns.org} VITE_MULTIPLAYER_DISABLED=true pnpm build",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler pages deploy --branch main",
    "deploy:server": "wrangler deploy --config deploy/cloudflare-server/wrangler.jsonc",
    "test:e2e": "playwright test",
    "build": "pnpm -r run build",
    "test": "node --test scripts/tests/*.test.cjs && pnpm -r run test",
    "lint": "pnpm -r run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "fast-xml-parser": "^5.11.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "wrangler": "4.149.0",
    "xnb": "1.3.0-a"
  }
}
